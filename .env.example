# Телеграм
TELEGRAM_TOKEN=your_bot_token_here
ADMIN_ID=123456789

# Принтер
PRINTER_HOST=192.168.1.100
PRINTER_PORT=631

# Опционально: прокси для Telegram API (socks5://host:port или http://host:port)
# PROXY_URL=socks5://127.0.0.1:1080

# TTL кэша заданий печати (минуты)
JOB_TTL_MINUTES=15

# Максимальное количество копий (опционально, по умолчанию 10)
MAX_COPIES=10
